# =====================================================================
#  Copie este arquivo para ".env" e preencha com seus dados.
#  O arquivo .env NÃO vai para o Git (está no .gitignore).
# =====================================================================

# Chave usada para assinar a sessão de login. Gere uma com:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-esta-chave

# ---------------------------------------------------------------------
# BANCO LOCAL (MySQL Workbench)
# ---------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=sua_senha_do_mysql
DB_NAME=salao_agenda

# ---------------------------------------------------------------------
# BANCO NA NUVEM (deploy no Render) - descomente e ajuste UM dos blocos
# e comente o bloco local acima. Os dados aparecem no painel do serviço
# (botão "Connect"). Ambos exigem conexão SSL.
# ---------------------------------------------------------------------
# --- TiDB Cloud (Serverless) ---
# DB_HOST=gateway01.us-east-1.prod.aws.tidbcloud.com
# DB_PORT=4000
# DB_USER=xxxxxxxx.root
# DB_PASSWORD=senha_do_tidb
# DB_NAME=salao_agenda
# # Certificados raiz do sistema Linux (já existem no Render)
# DB_SSL_CA=/etc/ssl/certs/ca-certificates.crt

# --- Aiven for MySQL ---
# DB_HOST=mysql-xxxxxx-seuprojeto.aivencloud.com
# DB_PORT=12345
# DB_USER=avnadmin
# DB_PASSWORD=senha_do_aiven
# DB_NAME=salao_agenda
# # Baixe o "CA certificate" no painel do Aiven e salve como ca.pem
# DB_SSL_CA=ca.pem

# Alternativa: uma URL completa substitui todas as variáveis DB_* acima.
# DATABASE_URL=mysql+pymysql://usuario:senha@host:porta/salao_agenda

# Fuso aplicado à sessão do banco (NOW()/CURRENT_TIMESTAMP em horário de
# Brasília mesmo em servidores UTC, como TiDB e Aiven)
DB_TIMEZONE=-03:00

# ---------------------------------------------------------------------
# REGRAS DO SALÃO
# ---------------------------------------------------------------------
SALAO_NOME=Salão Bela Vida
SALAO_ABERTURA=08:00
SALAO_FECHAMENTO=20:00
# Dias de funcionamento: 0=segunda ... 6=domingo
SALAO_DIAS_FUNCIONAMENTO=0,1,2,3,4,5
# Intervalo (minutos) entre os horários livres sugeridos na agenda
AGENDA_INTERVALO_MINUTOS=15

# ---------------------------------------------------------------------
# WHATSAPP
# ---------------------------------------------------------------------
# "simulado": registra a mensagem e gera o link wa.me (usado no vídeo)
WHATSAPP_MODO=simulado
# Antecedência do lembrete automático, em horas
LEMBRETE_HORAS_ANTES=24
# Token exigido pelo endpoint de lembretes chamado pelo cron externo
CRON_TOKEN=troque-este-token
